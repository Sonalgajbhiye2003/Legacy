<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_operation_tree" model="ir.ui.view">
        <field name="name">legacy.repair.operation.tree</field><field name="model">legacy.repair.operation</field>
        <field name="arch" type="xml"><tree editable="bottom"><field name="company_id" column_invisible="1"/><field name="sequence" widget="handle"/><field name="name"/><field name="workcenter_id"/><field name="supervisor_id"/><field name="planned_hours"/><field name="actual_approved_hours"/><field name="expense_type"/><field name="labour_cost" sum="Labour"/><field name="resource_cost" sum="Resource"/><field name="state" widget="badge"/></tree></field>
    </record>
    <record id="view_repair_operation_form" model="ir.ui.view">
        <field name="name">legacy.repair.operation.form</field><field name="model">legacy.repair.operation</field>
        <field name="arch" type="xml"><form><header><button name="action_ready" type="object" string="Ready" invisible="state != 'draft'"/><button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('ready', 'paused')"/><button name="action_pause" type="object" string="Pause" invisible="state != 'in_progress'"/><button name="action_done" type="object" string="Done" class="btn-primary" invisible="state not in ('in_progress', 'paused')"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/><field name="state" widget="statusbar"/></header><sheet><field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="repair_order_id"/><field name="maintenance_team_id"/><field name="supervisor_id"/><field name="workcenter_id"/><field name="expense_type"/></group><group><field name="planned_start"/><field name="planned_end"/><field name="actual_start"/><field name="actual_end"/><field name="planned_hours"/><field name="actual_approved_hours"/></group></group><notebook><page string="Labour"><field name="labour_ids" context="{'default_repair_order_id': repair_order_id}"><tree><field name="company_id" column_invisible="1"/><field name="employee_id"/><field name="work_date"/><field name="actual_hours"/><field name="expense_type"/><field name="approval_state" widget="badge"/><field name="labour_cost"/></tree></field></page><page string="Description"><field name="description"/></page><page string="Notes"><field name="notes"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field>
    </record>
    <record id="view_repair_labour_tree" model="ir.ui.view">
        <field name="name">legacy.repair.labour.tree</field><field name="model">legacy.repair.labour</field>
        <field name="arch" type="xml"><tree><field name="company_id" column_invisible="1"/><field name="work_date"/><field name="repair_order_id"/><field name="operation_id"/><field name="employee_id"/><field name="actual_hours"/><field name="expense_type"/><field name="approval_state" widget="badge"/><field name="accounting_status" widget="badge"/><field name="labour_cost" sum="Total"/><field name="timer_state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></tree></field>
    </record>
    <record id="view_repair_labour_form" model="ir.ui.view">
        <field name="name">legacy.repair.labour.form</field><field name="model">legacy.repair.labour</field>
        <field name="arch" type="xml"><form><header><button name="action_start_timer" type="object" string="Start" class="btn-primary" invisible="timer_state != 'stopped'"/><button name="action_pause_timer" type="object" string="Pause" invisible="timer_state != 'running'"/><button name="action_resume_timer" type="object" string="Resume" class="btn-primary" invisible="timer_state != 'paused'"/><button name="action_finish_timer" type="object" string="Finish" class="btn-primary" invisible="timer_state not in ('running', 'paused')"/><button name="action_submit" type="object" string="Submit" invisible="approval_state != 'draft' or timer_state != 'finished'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="approval_state != 'submitted'" groups="legacy_maintenance_repair_accounting.group_labour_approver,legacy_maintenance_repair_accounting.group_repair_supervisor"/><button name="action_reject" type="object" string="Reject" invisible="approval_state != 'submitted'" groups="legacy_maintenance_repair_accounting.group_labour_approver,legacy_maintenance_repair_accounting.group_repair_supervisor"/><field name="approval_state" widget="statusbar"/></header><sheet><field name="company_id" invisible="1"/><field name="currency_id" invisible="1"/><group><group><field name="repair_order_id"/><field name="operation_id" domain="[('repair_order_id', '=', repair_order_id)]"/><field name="employee_id"/><field name="department_id"/><field name="work_date"/><field name="expense_type"/></group><group><field name="start_datetime"/><field name="end_datetime"/><field name="break_duration"/><field name="paused_hours"/><field name="actual_hours"/><field name="hourly_rate"/><field name="labour_cost"/><field name="timer_state" readonly="1"/><field name="accounting_status" readonly="1"/></group></group><group string="Manual Entry"><field name="is_manual"/><field name="manual_adjustment_reason" required="is_manual"/><field name="allow_overlap"/></group><field name="notes"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field>
    </record>
    <record id="action_repair_operations" model="ir.actions.act_window"><field name="name">Repair/Build Operations</field><field name="res_model">legacy.repair.operation</field><field name="view_mode">tree,form</field></record>
    <record id="action_repair_labour" model="ir.actions.act_window"><field name="name">Labour Register</field><field name="res_model">legacy.repair.labour</field><field name="view_mode">tree,form</field></record>
    <record id="view_repair_order_operations_labour" model="ir.ui.view">
        <field name="name">repair.order.form.operations.labour</field><field name="model">repair.order</field><field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_view_legacy_labour" type="object" class="oe_stat_button" icon="fa-users" invisible="not legacy_labour_count"><field name="legacy_labour_count" widget="statinfo" string="Labour"/></button></xpath><xpath expr="//notebook" position="inside"><page string="Operations" name="legacy_operations"><field name="legacy_operation_ids" context="{'default_repair_order_id': id}"><tree editable="bottom"><field name="company_id" column_invisible="1"/><field name="sequence" widget="handle"/><field name="name"/><field name="workcenter_id"/><field name="supervisor_id"/><field name="planned_hours"/><field name="actual_approved_hours"/><field name="expense_type"/><field name="state" widget="badge"/></tree></field></page><page string="Labour" name="legacy_labour"><field name="legacy_labour_ids" context="{'default_repair_order_id': id}"><tree><field name="company_id" column_invisible="1"/><field name="operation_id"/><field name="employee_id"/><field name="work_date"/><field name="actual_hours"/><field name="expense_type"/><field name="approval_state" widget="badge"/><field name="labour_cost"/></tree></field></page></xpath></field>
    </record>
    <menuitem id="menu_repair_operations" name="Operations" parent="repair.menu_repair_order" action="action_repair_operations" sequence="30" groups="legacy_maintenance_repair_accounting.group_repair_supervisor"/>
    <menuitem id="menu_repair_labour" name="Labour Register" parent="repair.menu_repair_order" action="action_repair_labour" sequence="40" groups="legacy_maintenance_repair_accounting.group_labour_user,legacy_maintenance_repair_accounting.group_labour_approver"/>
</odoo>
