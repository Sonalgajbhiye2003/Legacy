<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legacy_repair_cost_reconciliation_tree" model="ir.ui.view"><field name="name">legacy.repair.cost.reconciliation.tree</field><field name="model">legacy.repair.cost.reconciliation</field><field name="arch" type="xml"><tree decoration-danger="reconciliation_state == 'exception'" decoration-success="reconciliation_state == 'ok'"><field name="repair_order_id"/><field name="order_type"/><field name="equipment_id"/><field name="workcenter_id"/><field name="material_cost" sum="Material"/><field name="stock_valuation_value" sum="Valuation"/><field name="material_journal_value" sum="Journal"/><field name="material_difference" sum="Difference"/><field name="approved_labour_cost" sum="Approved Labour"/><field name="labour_journal_value" sum="Posted Labour"/><field name="labour_difference" sum="Difference"/><field name="posted_capex" sum="CAPEX"/><field name="cwip_value" sum="CWIP"/><field name="capitalization_value" sum="Capitalized"/><field name="reconciliation_state" widget="badge"/><field name="exception_summary"/></tree></field></record>
    <record id="view_legacy_repair_cost_reconciliation_search" model="ir.ui.view"><field name="name">legacy.repair.cost.reconciliation.search</field><field name="model">legacy.repair.cost.reconciliation</field><field name="arch" type="xml"><search><field name="repair_order_id"/><field name="equipment_id"/><field name="workcenter_id"/><filter name="exceptions" string="Exceptions" domain="[('reconciliation_state','=','exception')]"/><filter name="build" string="Builds" domain="[('order_type','=','build')]"/><group expand="0" string="Group By"><filter name="group_type" string="Type" context="{'group_by':'order_type'}"/><filter name="group_state" string="State" context="{'group_by':'reconciliation_state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
    <record id="view_legacy_repair_cost_reconciliation_pivot" model="ir.ui.view"><field name="name">legacy.repair.cost.reconciliation.pivot</field><field name="model">legacy.repair.cost.reconciliation</field><field name="arch" type="xml"><pivot><field name="order_type" type="row"/><field name="company_id" type="col"/><field name="material_cost" type="measure"/><field name="approved_labour_cost" type="measure"/><field name="posted_capex" type="measure"/><field name="cwip_value" type="measure"/></pivot></field></record>
    <record id="view_legacy_repair_cost_reconciliation_graph" model="ir.ui.view"><field name="name">legacy.repair.cost.reconciliation.graph</field><field name="model">legacy.repair.cost.reconciliation</field><field name="arch" type="xml"><graph><field name="order_type"/><field name="material_cost" type="measure"/><field name="approved_labour_cost" type="measure"/></graph></field></record>
    <record id="action_legacy_repair_cost_reconciliation" model="ir.actions.act_window"><field name="name">Accounting Reconciliation</field><field name="res_model">legacy.repair.cost.reconciliation</field><field name="view_mode">tree,pivot,graph</field></record>
    <record id="action_legacy_repair_exceptions" model="ir.actions.act_window"><field name="name">Unposted / Exception Items</field><field name="res_model">legacy.repair.cost.reconciliation</field><field name="view_mode">tree,pivot,graph</field><field name="domain">[('reconciliation_state','=','exception')]</field></record>
    <record id="action_legacy_repair_cost_summary" model="ir.actions.act_window"><field name="name">Repair / Build Cost Summary</field><field name="res_model">repair.order</field><field name="view_mode">tree,pivot,graph,form</field></record>
    <record id="action_legacy_material_traceability" model="ir.actions.act_window"><field name="name">Material Consumption Traceability</field><field name="res_model">stock.request</field><field name="view_mode">tree,form</field><field name="domain">[('legacy_fulfillment_owner','=','repair')]</field></record>
    <record id="action_legacy_operation_progress" model="ir.actions.act_window"><field name="name">Operation Progress</field><field name="res_model">legacy.repair.operation</field><field name="view_mode">tree,form</field></record>
    <record id="action_legacy_capex_opex_register" model="ir.actions.act_window"><field name="name">CAPEX / OPEX Register</field><field name="res_model">stock.request</field><field name="view_mode">tree,form</field><field name="domain">[('legacy_fulfillment_owner','=','repair')]</field></record>
    <menuitem id="menu_legacy_reporting" name="Maintenance Cost Reporting" parent="repair.menu_repair_order" sequence="80" groups="legacy_maintenance_repair_accounting.group_repair_supervisor,legacy_maintenance_repair_accounting.group_finance_maintenance_approver"/>
    <menuitem id="menu_legacy_cost_summary" name="Repair / Build Cost Summary" parent="menu_legacy_reporting" action="action_legacy_repair_cost_summary" sequence="10"/>
    <menuitem id="menu_legacy_material_traceability" name="Material Consumption Traceability" parent="menu_legacy_reporting" action="action_legacy_material_traceability" sequence="20"/>
    <menuitem id="menu_legacy_operation_progress" name="Operation Progress" parent="menu_legacy_reporting" action="action_legacy_operation_progress" sequence="30"/>
    <menuitem id="menu_legacy_capex_opex" name="CAPEX / OPEX Register" parent="menu_legacy_reporting" action="action_legacy_capex_opex_register" sequence="40"/>
    <menuitem id="menu_legacy_reconciliation" name="Accounting Reconciliation" parent="menu_legacy_reporting" action="action_legacy_repair_cost_reconciliation" sequence="50"/>
    <menuitem id="menu_legacy_exceptions" name="Unposted / Exception Items" parent="menu_legacy_reporting" action="action_legacy_repair_exceptions" sequence="60"/>
</odoo>
