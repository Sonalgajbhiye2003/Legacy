<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_legacy_maintenance" model="ir.ui.view">
        <field name="name">res.config.settings.form.legacy.maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Maintenance and Repair Accounting" name="legacy_maintenance_accounting" groups="account.group_account_manager">
                    <setting string="CAPEX and PPE Accounts" company_dependent="1" help="Accounts used for build accumulation and capitalization.">
                        <div class="content-group">
                            <div class="row mt16"><label for="legacy_cwip_account_id" class="col-lg-4 o_light_label"/><field name="legacy_cwip_account_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_ppe_account_id" class="col-lg-4 o_light_label"/><field name="legacy_ppe_account_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_accumulated_depreciation_account_id" class="col-lg-4 o_light_label"/><field name="legacy_accumulated_depreciation_account_id" options="{'no_create': True}"/></div>
                        </div>
                    </setting>
                    <setting string="Repair and Material Accounts" company_dependent="1" help="Accounts used for OPEX repairs and manual material valuation.">
                        <div class="content-group">
                            <div class="row mt16"><label for="legacy_repair_expense_account_id" class="col-lg-4 o_light_label"/><field name="legacy_repair_expense_account_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_inventory_account_id" class="col-lg-4 o_light_label"/><field name="legacy_inventory_account_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_material_journal_id" class="col-lg-4 o_light_label"/><field name="legacy_material_journal_id" options="{'no_create': True}"/></div>
                        </div>
                    </setting>
                    <setting string="Consumption Locations" company_dependent="1" help="Production locations used by Repair Part moves for CAPEX and OPEX issues.">
                        <div class="content-group">
                            <div class="row mt16"><label for="legacy_capex_location_id" class="col-lg-4 o_light_label"/><field name="legacy_capex_location_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_opex_location_id" class="col-lg-4 o_light_label"/><field name="legacy_opex_location_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_zero_cost_policy" class="col-lg-4 o_light_label"/><field name="legacy_zero_cost_policy"/></div>
                        </div>
                    </setting>
                    <setting string="Maintenance Labour" company_dependent="1" help="Controls reporting and approved labour accounting.">
                        <div class="content-group">
                            <div class="row mt16"><label for="legacy_labour_posting_mode" class="col-lg-4 o_light_label"/><field name="legacy_labour_posting_mode"/></div>
                            <div class="row mt16"><label for="legacy_default_labour_hourly_rate" class="col-lg-4 o_light_label"/><field name="legacy_default_labour_hourly_rate"/></div>
                            <div class="row mt16"><label for="legacy_labour_clearing_account_id" class="col-lg-4 o_light_label"/><field name="legacy_labour_clearing_account_id" options="{'no_create': True}"/></div>
                            <div class="row mt16"><label for="legacy_labour_journal_id" class="col-lg-4 o_light_label"/><field name="legacy_labour_journal_id" options="{'no_create': True}"/></div>
                        </div>
                    </setting>
                    <setting string="Build Capitalization" company_dependent="1" help="Journal used to transfer completed Build cost from CWIP to PPE.">
                        <field name="legacy_capitalization_journal_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

