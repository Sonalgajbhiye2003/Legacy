<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_repair_supervisor" model="res.groups">
        <field name="name">Repair Supervisor</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('maintenance.group_equipment_manager'))]"/>
    </record>
    <record id="group_labour_approver" model="res.groups">
        <field name="name">Maintenance Labour Approver</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_labour_user" model="res.groups">
        <field name="name">Maintenance Labour User</field>
        <field name="category_id" ref="base.module_category_manufacturing_maintenance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_finance_maintenance_approver" model="res.groups">
        <field name="name">Maintenance CAPEX/OPEX Approver</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
    <record id="group_asset_capitalization_user" model="res.groups">
        <field name="name">Asset Capitalization User</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_maintenance_approver'))]"/>
    </record>
    <data noupdate="1">
        <record id="repair_operation_company_rule" model="ir.rule">
            <field name="name">Repair Operation: company</field>
            <field name="model_id" ref="model_legacy_repair_operation"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="repair_labour_company_rule" model="ir.rule">
            <field name="name">Repair Labour: company</field>
            <field name="model_id" ref="model_legacy_repair_labour"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="equipment_component_company_rule" model="ir.rule">
            <field name="name">Equipment Component: company</field><field name="model_id" ref="model_maintenance_equipment_component"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="equipment_component_event_company_rule" model="ir.rule">
            <field name="name">Equipment Component Event: company</field><field name="model_id" ref="model_maintenance_equipment_component_event"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="repair_cost_reconciliation_company_rule" model="ir.rule">
            <field name="name">Repair Cost Reconciliation: company</field><field name="model_id" ref="model_legacy_repair_cost_reconciliation"/><field name="global" eval="True"/><field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
