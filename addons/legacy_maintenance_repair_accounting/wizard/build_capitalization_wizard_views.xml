<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legacy_build_capitalization_wizard_form" model="ir.ui.view">
        <field name="name">legacy.build.capitalization.wizard.form</field>
        <field name="model">legacy.build.capitalization.wizard</field>
        <field name="arch" type="xml">
            <form string="Capitalize Build">
                <group><field name="repair_order_id"/><field name="target_workcenter_id"/><field name="equipment_id"/><field name="commissioning_date"/><field name="accounting_date"/></group>
                <group string="Capitalizable Cost"><field name="material_capex"/><field name="labour_capex"/><field name="total_capitalizable_cost"/></group>
                <group string="Accounting"><field name="journal_id"/><field name="cwip_account_id"/><field name="ppe_account_id"/><field name="asset_availability"/></group>
                <footer><button name="action_capitalize" type="object" string="Capitalize" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
