<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_labour_cost" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.labour.cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Manufacturing Labour Accounting"
                       name="manufacturing_labour_accounting"
                       groups="account.group_account_manager">
                    <setting string="Manufacturing Labour Journal"
                             company_dependent="1"
                             help="Post supplementary Manufacturing Order labour costs to a Miscellaneous journal.">
                        <field name="manufacturing_labour_journal_id"
                               domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Manufacturing Labour Debit Account"
                             company_dependent="1"
                             help="Expense or WIP account debited for manufacturing labour.">
                        <field name="manufacturing_labour_debit_account_id"
                               domain="[('deprecated', '=', False), ('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Manufacturing Labour Credit Account"
                             company_dependent="1"
                             help="Clearing or payable account credited for manufacturing labour.">
                        <field name="manufacturing_labour_credit_account_id"
                               domain="[('deprecated', '=', False), ('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
