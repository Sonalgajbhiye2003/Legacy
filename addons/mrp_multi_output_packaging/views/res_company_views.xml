<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_multi_output" model="ir.ui.view">
        <field name="name">res.company.form.multi.output</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Multi-Output Manufacturing Tolerances" groups="mrp_multi_output_packaging.group_multi_output_supervisor">
                    <field name="quantity_warning_tolerance"/>
                    <field name="quantity_blocking_tolerance"/>
                    <field name="packaging_variance_reason_threshold"/>
                    <field name="byproduct_variance_reason_threshold"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
