<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_request_rejection_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.rejection.wizard.form</field>
        <field name="model">stock.request.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Refuse Material Requisition">
                <group>
                    <field name="stock_request_id" invisible="not stock_request_id"/>
                    <field name="stock_request_order_id" invisible="not stock_request_order_id"/>
                    <field name="rejection_reason"
                           placeholder="Explain why this Material Requisition is being refused..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object"
                            string="Refuse" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
