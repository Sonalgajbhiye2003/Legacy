<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_request_purchase_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.purchase.wizard.form</field>
        <field name="model">stock.request.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase Order">
                <group>
                    <field name="request_order_id"/>
                    <field name="partner_id" options="{'no_create': True}"/>
                    <field name="date_order"/>
                </group>
                <footer>
                    <button name="action_create_purchase_order" type="object"
                            string="Create Purchase Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_stock_request_transfer_wizard_form" model="ir.ui.view">
        <field name="name">stock.request.transfer.wizard.form</field>
        <field name="model">stock.request.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Internal Transfer">
                <group>
                    <field name="request_order_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="picking_type_id" options="{'no_create': True}"/>
                    <field name="location_id" options="{'no_create': True}"/>
                    <field name="location_dest_id" options="{'no_create': True}"/>
                    <field name="scheduled_date"/>
                </group>
                <footer>
                    <button name="action_create_internal_transfer" type="object"
                            string="Create Internal Transfer" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
