<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_request_approval_config_list" model="ir.ui.view">
        <field name="name">stock.request.approval.config.list</field>
        <field name="model">stock.request.approval.config</field>
        <field name="arch" type="xml">
            <tree default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="level_1_approver_id" widget="many2one_avatar_user"/>
                <field name="level_2_approver_id" widget="many2one_avatar_user" optional="show"/>
                <field name="level_3_approver_id" widget="many2one_avatar_user" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_request_approval_config_form" model="ir.ui.view">
        <field name="name">stock.request.approval.config.form</field>
        <field name="model">stock.request.approval.config</field>
        <field name="arch" type="xml">
            <form string="Stock Request Approval Matrix">
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Main Stock Request Approval"/></h1>
                    </div>
                    <group>
                        <group string="Applicability">
                            <field name="active" invisible="1"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="requester_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Approvers">
                            <field name="level_1_approver_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                            <field name="level_2_approver_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                            <field name="level_3_approver_id" widget="many2one_avatar_user"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_request_approval_config" model="ir.actions.act_window">
        <field name="name">Approval Matrix</field>
        <field name="res_model">stock.request.approval.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_stock_request_approval_config"
              name="Approval Matrix"
              parent="menu_stock_request_master_data"
              action="action_stock_request_approval_config"
              sequence="20"
              groups="stock_request.group_stock_request_manager"/>
</odoo>
