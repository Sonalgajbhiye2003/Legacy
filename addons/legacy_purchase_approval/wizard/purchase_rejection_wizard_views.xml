<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_rejection_wizard_form" model="ir.ui.view">
        <field name="name">legacy.purchase.rejection.wizard.form</field>
        <field name="model">legacy.purchase.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Purchase Order">
                <group>
                    <field name="purchase_order_id"/>
                    <field name="rejection_reason"
                           placeholder="Explain why this Purchase Order is being rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection" type="object"
                            string="Reject" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
