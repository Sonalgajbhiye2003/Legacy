<odoo>
    <template id="pdf_main" inherit_id="account_reports.pdf_export_main" primary="True">
        <xpath expr="//t[@t-call-assets]" position="replace">
            <style>
                body { font-family: Arial, sans-serif; font-size: 9pt; color: #222; }
                .o_title { font-size: 15pt; font-weight: bold; margin-bottom: 8px; }
                .o_table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                .o_table th, .o_table td { padding: 4px 6px; vertical-align: top; overflow-wrap: break-word; }
                .o_table th { border-bottom: 1px solid #555; text-align: right; background: #eeeeee; }
                .o_table td { text-align: right; line-height: 1.35; }
                .o_cell_td span { white-space: nowrap; font-size: 8pt; }
                .o_table th:first-child, .o_table td:first-child { text-align: left; }
                .o_line_level_0 { font-weight: bold; border-top: 1px solid #999; }
                .o_line_level_2 td:first-child { padding-left: 14px; }
                .o_fw_bold { font-weight: bold; }
                .o_footnote { font-size: 8pt; }
                tr { page-break-inside: avoid; }
                thead { display: table-header-group; }
            </style>
        </xpath>
        <xpath expr="//table[hasclass('o_table')]/t[1]" position="before">
            <colgroup>
                <col t-att-style="'width:70%' if report.legacy_kind == 'bs' else 'width:29%'"/>
                <col t-foreach="options['columns']" t-as="column" t-att-style="'width:30%' if report.legacy_kind == 'bs' else 'width:10.14%'"/>
            </colgroup>
        </xpath>
        <xpath expr="//header" position="after">
            <p style="font-size: 9pt; color: #805300;">
                <strong>PROVISIONAL: </strong>Unapproved mappings and missing budget data remain unresolved. Totals are partial. See the detailed exceptions after the report.
            </p>
        </xpath>
        <xpath expr="//table[hasclass('o_table')]" position="after">
            <p style="font-size: 8pt; color: #805300; margin-top: 14px;">
                <strong>Reconciliation and source exceptions: </strong>
                <span t-out="options.get('legacy_diagnostic', options.get('legacy_notes', ''))"/>
            </p>
        </xpath>
    </template>
    <template id="pdf_footer">
        <html><head><meta charset="utf-8"/></head>
            <body style="font-family:Arial,sans-serif;font-size:8pt;color:#666;margin:0;">
                <div style="border-top:1px solid #bbb;padding-top:5px;">
                    <span t-out="company.name"/> — Provisional financial report
                </div>
            </body>
        </html>
    </template>
</odoo>
